project: peg-markdown
target: markdown
# File-input target: the full PEG parser + HTML writer via the CLI. Two-entry testsuite
# keeps BOTH the server-accumulated corpus and the git-tracked starter seeds (relative
# file:// path, resolved against the CI checkout).
# mayhem-lint: keep-testsuite
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/markdown/testsuite
cmds:
  - cmd: /mayhem/markdown @@
